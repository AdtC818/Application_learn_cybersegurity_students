// Prisma schema — see https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

/// One completed static-analysis run, kept so a student can revisit
/// code they analyzed before. Findings are stored as JSON rather than as
/// a related table: they are never queried on their own, only ever read
/// back as a whole alongside their parent analysis.
model Analisis {
  id             String   @id @default(cuid())
  nombreArchivo  String?
  codigoFuente   String
  lenguaje       String   @default("javascript")
  hallazgos      Json
  totalHallazgos Int      @default(0)
  creadoEn       DateTime @default(now())

  @@map("analisis")
}
